{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@assets/*": [
        "./src/assets/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@entities/*":[
        "./src/entities/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@shared/api": [
        "./src/shared/api/index"
      ],
      "@shared/components/*": [
        "./src/shared/components/*"
      ],
      "@shared/config/*": [
        "./src/shared/config/*"
      ],
      "@shared/constants": [
        "./src/shared/constants/index"
      ],
      "@shared/hooks": [
        "./src/shared/hooks/index"
      ],
      "@shared/ui/*": [
        "./src/shared/ui/*"
      ],
      "@shared/utils/*": [
        "./src/shared/utils/*"
      ],
      "@shared/types": [
        "./src/shared/types/index"
      ],
      "@shared/store": [
        "./src/shared/store/index"
      ],
      "@lib/*": [
        "./src/lib/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
