{
    "name": "mailsense-backend",
    "version": "3.0.0",
    "type": "module",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "node dist/server.js",
        "build": "tsc && tsc-alias",
        "build:clean": "rm -rf dist && pnpm build",
        "dev": "tsx src/server.ts",
        "dev:prod": "NODE_ENV=prod tsx src/server.ts",
        "lint": "eslint src --ext .ts --max-warnings 0",
        "lint-fix": "eslint src --ext .ts --fix",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "format": "prettier --write \"src/**/*.ts\"",
        "type-check": "tsc --noEmit",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@11.22.0",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1113.0",
        "@mailsense/types": "^1.3.2",
        "@sentry/node": "^10.70.0",
        "axios": "^1.19.0",
        "bullmq": "^5.81.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-oauth2-jwt-bearer": "^1.10.0",
        "html-to-text": "^9.0.5",
        "ioredis": "5.10.1",
        "mongoose": "^8.24.3",
        "multer": "^2.2.0",
        "pino": "^9.14.0",
        "pino-pretty": "^13.1.3",
        "validator": "^13.15.35",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/html-to-text": "^9.0.4",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^24.13.3",
        "@types/supertest": "^6.0.3",
        "@types/validator": "^13.15.10",
        "eslint": "^9.39.5",
        "eslint-plugin-unused-imports": "^4.4.1",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.9.2",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0"
    }
}
